<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.fathzer</groupId>
  <artifactId>yapbam-deployer</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  
  <licenses>
    <license>
      <name>GNU General Public License v3 (GPL-v3)</name>
      <url>http://www.gnu.org/licenses/gpl-3.0.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <scm>
    <url>http://svn.code.sf.net/p/yapbam/code</url>
    <connection>http://svn.code.sf.net/p/yapbam/code</connection>
  </scm>
  
  <developers>
    <developer>
      <id>Fathzer</id>
      <name>Jean-Marc Astesana</name>
      <email>admin@fathzer.com</email>
    </developer>
  </developers>
  
  <properties>
    <project.build.sourceEncoding>ISO-8859-1</project.build.sourceEncoding>
  </properties>
  
  <dependencies>
  	<dependency>
		<groupId>org.apache.commons</groupId>
		<artifactId>commons-vfs2</artifactId>
		<version>2.0</version>
	</dependency>
	  	<dependency>
		<groupId>com.fathzer</groupId>
		<artifactId>ajlib</artifactId>
		<version>0.2.1</version>
	</dependency>
	  	<dependency>
	  		<groupId>com.jcraft</groupId>
	  		<artifactId>jsch</artifactId>
	  		<version>0.1.50</version>
	  	</dependency>
  </dependencies>
  
  <build>
    <sourceDirectory>src</sourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.1</version>
        <configuration>
          <source>1.6</source>
          <target>1.6</target>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>