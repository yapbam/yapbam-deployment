<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.fathzer</groupId>
	<artifactId>yapbam-deployer</artifactId>
	<version>0.0.4</version>

	<licenses>
		<license>
			<name>GNU General Public License v3 (GPL-v3)</name>
			<url>http://www.gnu.org/licenses/gpl-3.0.html</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<scm>
		<url>http://svn.code.sf.net/p/yapbam/code</url>
		<connection>http://svn.code.sf.net/p/yapbam/code</connection>
	</scm>

	<developers>
		<developer>
			<id>Fathzer</id>
			<name>Jean-Marc Astesana</name>
			<email>admin@fathzer.com</email>
		</developer>
	</developers>

	<properties>
		<project.build.sourceEncoding>ISO-8859-1</project.build.sourceEncoding>
	</properties>

	<dependencies>
		<!--dependency>
			<groupId>com.fathzer</groupId>
			<artifactId>jdeployer</artifactId>
			<version>1.1.1</version>
		</dependency-->
		<!-- The following dependencies can be replaced with the jdeployer dependency if it becomes publicly available -->
		<dependency>
			<groupId>com.fathzer</groupId>
			<artifactId>ajlib</artifactId>
			<version>0.3.16</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-vfs2</artifactId>
			<version>2.9.0</version>
		</dependency>
		<dependency>
			<groupId>com.jcraft</groupId>
			<artifactId>jsch</artifactId>
			<version>0.1.55</version>
		</dependency>
		<!-- End of dependencies that can be replaced with the jdeployer dependency -->
		<dependency>
			<groupId>com.fathzer</groupId>
			<artifactId>yapbam-commons</artifactId>
			<version>1.9.0</version>
		</dependency>
	</dependencies>

	<build>
		<sourceDirectory>src</sourceDirectory>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.1</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>